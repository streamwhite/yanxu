{
  "manifest_version": 3,
  "name": "雁序 — 多平台投稿助手",
  "description": "从本地批量任务填充 Bilibili、抖音和视频号投稿页面；检查后由用户手动发布。",
  "version": "1.0.0",
  "permissions": ["scripting", "storage", "clipboardWrite", "tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.bilibili.cn/*",
    "https://creator.douyin.com/*",
    "https://*.douyin.com/*",
    "https://channels.weixin.qq.com/*"
  ],
  "action": {
    "default_title": "雁序",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "dist/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*", "https://*.bilibili.cn/*"],
      "js": ["dist/content-platform-fill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.douyin.com/*", "https://*.douyin.com/*"],
      "js": ["dist/content-platform-fill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://channels.weixin.qq.com/*"],
      "js": ["dist/content-platform-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
