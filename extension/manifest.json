{
  "manifest_version": 3,
  "name": "auto-upload (semi-auto)",
  "description": "Fill creator upload UIs (Bilibili, Douyin, 视频号) from local job JSON via native messaging. Manual publish only.",
  "version": "0.1.0",
  "permissions": ["nativeMessaging", "scripting", "storage", "clipboardWrite", "tabs"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.bilibili.cn/*",
    "https://creator.douyin.com/*",
    "https://*.douyin.com/*",
    "https://channels.weixin.qq.com/*"
  ],
  "action": {
    "default_title": "auto-upload semi-auto"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "dist/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*", "https://*.bilibili.cn/*"],
      "js": ["dist/content-platform-fill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.douyin.com/*", "https://*.douyin.com/*"],
      "js": ["dist/content-platform-fill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://channels.weixin.qq.com/*"],
      "js": ["dist/content-platform-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
