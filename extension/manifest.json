{
  "manifest_version": 3,
  "name": "auto-upload (semi-auto)",
  "description": "Fill Bilibili creator upload UI from local job JSON via native messaging. Manual publish only.",
  "version": "0.1.0",
  "permissions": ["nativeMessaging", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://*.bilibili.com/*", "https://*.bilibili.cn/*"],
  "action": {
    "default_title": "auto-upload semi-auto",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*", "https://*.bilibili.cn/*"],
      "js": ["dist/content-bilibili-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
