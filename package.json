{
  "name": "auto-upload-monorepo",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "jest --runInBand",
    "typecheck": "pnpm --filter @auto-upload/domain build && pnpm -r run typecheck",
    "build": "pnpm --filter @auto-upload/domain build && pnpm --filter @auto-upload/native-host build && node ./scripts/build-extension.mjs",
    "dev": "node ./scripts/dev.mjs",
    "install:native-host": "node ./scripts/install-native-host.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/chrome": "^0.1.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.14",
    "esbuild": "^0.27.3",
    "jest": "^30.2.3",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
