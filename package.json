{
  "name": "yanxu-workspace",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "jest --runInBand",
    "typecheck": "pnpm --filter @yanxu/domain build && pnpm -r run typecheck",
    "build": "pnpm --filter @yanxu/domain build && pnpm --filter @yanxu/native-host build && node ./scripts/build-extension.mjs",
    "package": "pnpm build && node ./scripts/package-extension.mjs",
    "package:windows": "pnpm build && node ./scripts/build-native-host-sea.mjs && node ./scripts/package-windows.mjs",
    "build:native-host:sea": "node ./scripts/build-native-host-sea.mjs",
    "dev": "node ./scripts/dev.mjs",
    "install:native-host": "node ./scripts/install-native-host.mjs",
    "setup:host": "./scripts/setup-host.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/chrome": "^0.1.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.14",
    "esbuild": "^0.27.3",
    "jest": "^30.2.3",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
