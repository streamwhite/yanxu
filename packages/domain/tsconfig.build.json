{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"lib": ["ES2022", "DOM"],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts"]
}
