{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM"],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@auto-upload/domain": ["packages/domain/src/index.ts"],
			"@auto-upload/domain/*": ["packages/domain/src/*"]
		}
	},
	"include": ["packages/**/*.ts", "*.ts", "packages/**/__tests__/**/*.ts", "tests/**/*.ts"]
}
